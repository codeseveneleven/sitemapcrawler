{
	"name": "code711/sitemapcrawler",
	"description": "Crawls sitemaps and triggers search index",
	"type": "typo3-cms-extension",
	"license": "MIT",
	"require": {
		"php": "^8.1",
		"typo3/cms-core": "^13.4"
	},
	"authors": [
		{
			"name": "Patricia Ottmar",
			"role": "Developer",
			"email": "p.ottmar@12bis3.de"
		}
	],
	"extra": {
		"typo3/cms": {
			"cms-package-dir": "{$vendor-dir}/typo3/cms",
			"web-dir": ".Build/public",
			"extension-key": "sitemapcrawler"
		}
	},
	"autoload": {
		"psr-4": {
			"Code711\\Sitemapcrawler\\": "Classes/"
		}
	}
}
